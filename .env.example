# Sentriq environment configuration
# Copy this file to .env and fill in real values.
#
# The defaults below describe a production deployment on a domain, because that
# is what people copy. For a localhost review, see the "Local review" block at
# the end of this file — do not deploy with those values.

APP_ENV=production

# Required: cookie signing key, generate with `openssl rand -hex 32`.
# It must not change between restarts, or every session is invalidated. The
# example placeholder below is refused at startup on purpose: a key that ships
# in the repository is not a key.
APP_SECRET_KEY=replace-with-at-least-64-hex-characters

# Required: the domain this is served on. Requests with any other Host header
# are refused before they reach a route, which is what stops Host-header
# poisoning and lookalike-name phishing against the sign-in page.
# Comma-separate several names if the app answers on more than one.
ALLOWED_HOSTS=sentriq.example.com

# Database. Postgres only: the app refuses to start without this, and refuses a
# sqlite:// URL. Both schemes work, postgres:// and postgresql://, and are routed
# to psycopg 3. The password must match POSTGRES_PASSWORD below.
DATABASE_URL=postgresql://sentriq:replace-with-a-strong-password@postgres:5432/sentriq
POSTGRES_PASSWORD=replace-with-a-strong-password

# Cookies. 1 is required in production and means the app is behind HTTPS.
# 0 is only for a localhost review over plain HTTP.
COOKIE_SECURE=1

# Workers. One worker is the safe default: the rate limiter and login-lockout
# counters live inside each worker unless REDIS_URL is set, so N workers allow N
# times the per-client limit and a lockout only covers the worker that saw the
# failure. Raise this only together with REDIS_URL (the app refuses to start in
# production otherwise).
# WEB_CONCURRENCY=4
# REDIS_URL=redis://redis:6379/0
# DB_POOL_SIZE=10
# DB_POOL_MAX_OVERFLOW=20

# Sessions. The absolute lifetime and the idle timeout inside it; the session
# ends at whichever comes first. 1800 means 30 minutes without a request.
# SESSION_TTL_SECONDS=28800
# SESSION_IDLE_SECONDS=1800

# Optional: rate limiting
# RATE_LIMIT_REQUESTS=120
# RATE_LIMIT_WINDOW=60

# Optional: max evidence upload size in bytes (default: 6 MB)
# MAX_UPLOAD_BYTES=6291456

# Optional: login lockout (default: 5 attempts per address+username, 300s window)
# LOGIN_LOCKOUT_THRESHOLD=5
# LOGIN_LOCKOUT_SECONDS=300

# Optional: timezone used to render timestamps (stored in UTC). Default Asia/Yangon.
# DISPLAY_TIMEZONE=Asia/Yangon

# Optional: per-account lockout across rotating addresses (default: 10)
# LOGIN_ACCOUNT_LOCKOUT_THRESHOLD=10

# Optional: password hashing cost (PBKDF2-SHA256 rounds). Raise it when the
# hardware allows; existing hashes are upgraded as their owners sign in.
# PASSWORD_ITERATIONS=600000

# Peers allowed to set X-Forwarded-For / X-Real-IP. In production this is the
# address your reverse proxy connects from, not a range: anything on the list
# can claim any client address, which would let it evade per-IP limits and
# poison the audit trail. Docker compose defaults to the bridge range because
# the proxy is on the host.
# TRUSTED_PROXIES=127.0.0.1/32,::1/128

# The public address, used in notification links (email and Teams).
PUBLIC_BASE_URL=https://sentriq.example.com

# Retention: archive and remove closed tickets older than this many days.
# The job runs on demand (python -m sentriq.manage retention --apply).
# RETENTION_DAYS=730
# ARCHIVE_DIR=data/archive
# AUDIT_EXPORT_DIR=data/audit-exports

# Backup monitoring: /healthz reports degraded when the newest snapshot is older.
# BACKUP_MAX_AGE_HOURS=36
# BACKUP_DIR=/app/backups

# Metrics: unset means /metrics only answers on loopback. Behind a proxy that is
# never the scraper's address, so set a token and scrape with
# "Authorization: Bearer <token>".
# METRICS_TOKEN=replace-with-a-long-random-string

# Notifications. Each channel stays off until it is configured.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=soc@example.com
# SMTP_PASSWORD=replace-me
# SMTP_STARTTLS=1
# NOTIFY_EMAIL_FROM=soc@example.com
# NOTIFY_EMAIL_TO=soc-team@example.com,oncall@example.com
# NOTIFY_TEAMS_WEBHOOK=https://example.webhook.office.com/webhookb2/...
# NOTIFY_ON_ASSIGN=1
# NOTIFY_ON_ESCALATE=1
# NOTIFY_MIN_SEVERITY=High

# ---------------------------------------------------------------------------
# Local review over plain HTTP on this machine only. Never use these values on
# a network, and never with real incidents in the database.
#
#   APP_ENV=review
#   COOKIE_SECURE=0
#   ALLOWED_HOSTS=localhost,127.0.0.1
#   PUBLIC_BASE_URL=http://localhost:8080
# ---------------------------------------------------------------------------
